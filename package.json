{
  "name": "hermes-teamboard",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "Hermes 多 Agent 组织看板 — 本地 TypeScript 代理 + React/antd 看板(构建期打包, 运行时零 npm 依赖)",
  "scripts": {
    "build": "tsc -p tsconfig.server.json && tsc -p tsconfig.web.json --noEmit && vite build",
    "start": "node dist/server.js",
    "dev": "npm run build && npm start",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit"
  },
  "engines": {
    "node": ">=18.14"
  },
  "dependencies": {
    "antd": "^5.21.0",
    "d3": "^7.9.2",
    "echarts": "^5.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}